{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
  "python.analysis.exclude": [
    "**/venv",
    "**/venv-*",
    "**/dist",
    "**/build",
    "**/build-assets",
    "**/testing-output",
    "**/storage",
    "**/__pycache__",
    "**/.pytest_cache"
  ],
  "files.watcherExclude": {
    "**/venv/**": true,
    "**/venv-*/**": true,
    "**/dist/**": true,
    "**/build-assets/**": true,
    "**/testing-output/**": true
  },
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"]
}
